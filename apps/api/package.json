{
	"name": "api",
	"version": "0.0.1",
	"description": "",
	"author": "",
	"private": true,
	"license": "UNLICENSED",
	"scripts": {
		"build": "nest build",
		"dev": "PORT=8000 nest start --watch",
		"start": "nest start",
		"start:dev": "nest start --watch",
		"start:debug": "nest start --debug --watch",
		"start:prod": "node dist/main",
		"lint": "biome lint .",
		"format": "biome format .",
		"type-check": "tsc --noEmit",
		"test": "vitest run",
		"check": "bun run lint && bun run type-check && bun run test",
		"test:watch": "vitest",
		"test:e2e": "vitest run --config vitest.config.e2e.mts",
		"auth:generate": "bunx @better-auth/cli@1.4.21 generate --config auth.cli.ts --output src/auth/auth.schema.ts -y && biome format --write src/auth/auth.schema.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "bun src/db/migrate.ts",
		"db:seed": "bun src/db/seed.ts"
	},
	"dependencies": {
		"@nestjs/common": "^11.0.1",
		"@nestjs/core": "^11.0.1",
		"@nestjs/platform-express": "^11.0.1",
		"@tenora/contracts": "workspace:*",
		"@tenora/tsconfig": "workspace:*",
		"@thallesp/nestjs-better-auth": "^2.8.0",
		"better-auth": "^1.7.28",
		"drizzle-orm": "^0.45.4",
		"pg": "^8.23.1",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.1",
		"zod": "^4.1.0"
	},
	"devDependencies": {
		"@nestjs/cli": "^11.0.0",
		"@nestjs/schematics": "^11.0.0",
		"@nestjs/testing": "^11.0.1",
		"@types/express": "^5.0.0",
		"@types/node": "catalog:",
		"@types/pg": "^8.23.1",
		"@types/supertest": "^6.0.2",
		"drizzle-kit": "^0.31.11",
		"source-map-support": "^0.5.21",
		"supertest": "^7.0.0",
		"ts-loader": "^9.5.2",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
