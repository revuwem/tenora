{
  "name": "tenora",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.10",
  "workspaces": {
    "packages": ["apps/*", "packages/*"],
    "catalog": {
      "typescript": "5.9.3",
      "react": "19.2.3",
      "react-dom": "19.2.3",
      "@types/node": "^26",
      "@types/react": "^19",
      "@types/react-dom": "^19",
      "tailwindcss": "^4"
    }
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --write",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "check": "turbo run lint type-check format test",
    "format": "turbo run format --log-order=grouped",
    "format:fix": "turbo run format --log-order=grouped -- --write",
    "docker:dev": "scripts/docker.sh dev up --build -V",
    "docker:dev:down": "scripts/docker.sh dev down",
    "docker:ports": "scripts/docker.sh dev ports",
    "docker:prod": "scripts/docker.sh prod up --build",
    "docker:prod:detached": "scripts/docker.sh prod up --build -d",
    "docker:prod:down": "scripts/docker.sh prod down"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.6",
    "turbo": "2.8.16",
    "typescript": "catalog:"
  }
}
